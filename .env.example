# Copy this file to `.env` and fill in your values:
#     cp .env.example .env
# `.env` is gitignored, so nothing here ever gets committed.

# --- Claude (required for AI summaries) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Email delivery (optional) ---
# Sends the finished digest to DIGEST_TO each morning. Leave these blank to
# skip email and only generate the local HTML page.
#
# Gmail setup:
#   1. Enable 2-Step Verification on the Google account.
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Paste that 16-character app password (NOT your Gmail login password)
#      into SMTP_PASS below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=clevelandevan1@gmail.com
SMTP_PASS=your-16-char-app-password
DIGEST_TO=clevelandevan1@gmail.com
DIGEST_FROM=clevelandevan1@gmail.com
